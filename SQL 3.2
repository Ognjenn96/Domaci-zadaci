---Zadatak 1 Prikažite naziv svakog kluba i naziv stadiona na kojem igra domaće utakmice.

SELECT t.team_name, s.stadium_name
FROM teams t
LEFT JOIN stadiums s
ON t.stadium_id = s.stadium_id;

---Zadatak 2 Prikažite ime i prezime igrača i naziv kluba za koji je igrao u sezoni 2024/25. Uklonite duplikate iz rezultata.
SELECT DISTINCT p.first_name, p.last_name, t.team_name
FROM player_match_stats s
JOIN players p ON s.player_id = p.player_id
JOIN teams t ON s.team_id = t.team_id
JOIN matches m ON s.match_id = m.match_id
WHERE m.season = '2024/25'
AND s.minutes_played > 0;

---Zadatak 3 Prikažite datum odigravanja utakmice, naziv stadiona i broj gledalaca za sve utakmice u sezoni 2024/25.

SELECT m.kickoff_ts,  m.attendance, s.stadium_name
FROM matches m
JOIN stadiums s
ON m.stadium_id = s.stadium_id
WHERE m.season = '2024/25';

---Srednji nivo 
--1.Prikažite sve utakmice za koje nije evidentiran broj gledalaca. Prikažite datum, domaći klub i gostujući klub.

SELECT m.kickoff_ts, h.team_name AS domacin, a.team_name AS gost
FROM matches m
JOIN teams h ON m.home_team_id = h.team_id
JOIN teams a ON m.away_team_id = a.team_id
WHERE m.attendance IS NULL;

-- 2.Pronađite stadione na kojima nije odigrana ni jedna utakmica u sezoni 2024/25.

SELECT s.stadium_name
FROM stadiums s
LEFT JOIN matches m
ON s.stadium_id = m.stadium_id
AND m.season = '2024/25'
WHERE m.match_id IS NULL;

-- 3 3.Za svaki klub izračunajte ukupan broj žutih kartona koje su dobili njegovi igrači u sezoni 2024/25. Rezultat sortirajte opadajuće prema broju kartona.

SELECT t.team_name,
 COUNT(*) AS broj_zutih_kartona
FROM match_events e
JOIN teams t ON e.team_id = t.team_id
JOIN matches m ON e.match_id = m.match_id
WHERE m.season = '2024/25'
AND e.event_type IN ('yellow_card', 'second_yellow')
GROUP BY t.team_name
ORDER BY broj_zutih_kartona DESC;