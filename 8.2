# 16. Napisati funkciju count_lines(path: str) -> int
# koja vraca broj nepraznih redova u fajlu
# Input: 'data/raw/teams.csv'
# Output: 5

import csv

def count_lines(path: str) -> int:
    lines = 0

    with open(path, 'r') as f:
        for line in f:
            if line.strip():
                lines += 1

    return lines

print(count_lines('data/raw/teams.csv'))

# 17. Napisati funkciju read_column(path: str, column: str) -> list
# koja vraca sve vrednosti jedne kolone CSV fajla
# Ako kolona ne postoji, vratiti []
# Input: 'data/raw/teams.csv', 'city'

import csv

def read_column(path: str, column: str) -> list:
    column_values = []

    with open(path, 'r') as f:
        teams = csv.DictReader(f)

        for team in teams:
            if column in team:
                column_values.append(team[column])

    return column_values

print(read_column('data/raw/teams.csv', 'city'))
 rezultat
['Bela Palanka', 'Niš', 'Beograd, Rakovica', 'Kraljevo']


# 18. Napisati funkciju write_key_value(path: str, data: dict, headers: list) -> None
# koja recnik upisuje u CSV fajl sa dve kolone
# Input: 'data/processed/summary.csv', {'rows': 10, 'valid': 6}, ['metric', 'value']

import csv

def write_key_value(path: str, data: dict, headers: list) -> None:
    data_lista = list(data.items())
    data_lista.insert(0, headers)

    with open(path, 'w', newline='') as f:
        csv.writer(f).writerows(data_lista)

write_key_value('data/processed/summary.csv',
                {'rows': 10, 'valid': 6},
                ['metric', 'value'])

with open('data/processed/summary.csv', 'r') as f:
    print(f.read())

rezultat

metric,value
rows,10
valid,6


# 19. Napisati funkciju get_header(path: str) -> list
# koja vraca zaglavlje CSV fajla
# Koristiti csv.reader i next()
# Input: 'data/raw/teams.csv'

import csv

def get_header(path: str) -> list:
    with open(path, 'r') as f:
        reader = csv.reader(f)
        header = next(reader)

    return header

print(get_header('data/raw/teams.csv'))

rezultat
['team', 'city', 'points']

# 20. Napisati funkciju read_rows(path: str) -> list
# koja vraca sve redove CSV fajla bez zaglavlja
# Koristiti csv.reader
# Input: 'data/raw/teams.csv'

import csv

def read_rows(path: str) -> list:
    with open(path, 'r') as f:
        reader = csv.reader(f)
        rows = []

        for row in reader:
            rows.append(row)

    return rows[1:]

print(read_rows('data/raw/teams.csv'))
