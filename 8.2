 [['FK Jedinstvo', 'Bela Palanka', '34'], ['FK Radnički', 'Niš', '41'], ['FK Rakovica', 'Beograd, Rakovica', '28'], ['FK Sloga', 'Kraljevo', '19']]

 # 21. Napisati funkciju total_points(path: str) -> int
# koja vraca zbir bodova svih timova
# Koristiti csv.DictReader
# Input: 'data/raw/teams.csv'
# Output: 122

import csv

def total_points(path: str) -> int:
    points = 0

    with open(path, 'r') as f:
        reader = csv.DictReader(f)

        for row in reader:
            points += int(row['points'])

    return points

print(total_points('data/raw/teams.csv'))

# 22. Napisati funkciju write_rows(path: str, rows: list) -> None
# koja listu listi upisuje u CSV fajl
# Input: 'data/processed/people.csv', [['name', 'age'], ['Ana', 20], ['Marko', 22]]

import csv

def write_rows(path: str, rows: list) -> None:
    with open(path, 'w', newline='') as f:
        writer = csv.writer(f)
        writer.writerows(rows)

write_rows('data/processed/people.csv',
           [['name', 'age'], ['Ana', 20], ['Marko', 22]])

with open('data/processed/people.csv', 'r') as f:
    print(f.read())

rezultat
name,age
Ana,20
Marko,22


# 23. Napisati funkciju write_dicts(path: str, rows: list) -> None
# koja listu recnika upisuje u CSV fajl
# Koristiti csv.DictWriter
# Input: 'data/processed/people.csv', [{'name': 'Ana', 'age': 20}, {'name': 'Marko', 'age': 22}]

import csv

def write_dicts(path: str, rows: list) -> None:
    headings = list(rows[0].keys())

    with open(path, 'w', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=headings)
        writer.writeheader()
        writer.writerows(rows)

write_dicts('data/processed/people.csv',
            [{'name': 'Ana', 'age': 20}, {'name': 'Marko', 'age': 22}])

with open('data/processed/people.csv', 'r') as f:
    print(f.read())
rezultat 
name,age
Ana,20
Marko,22
