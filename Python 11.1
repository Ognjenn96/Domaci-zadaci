
import requests

# 1. Informacije o svemirskoj stanici

def get_space_station() -> dict:
    url = 'http://api.open-notify.org/iss-now.json'

    r = requests.get(url)
    r.raise_for_status()
    data = r.json()

    return data['iss_position']


print(get_space_station())




# 2. Pretraga univerziteta

def get_universities(country: str) -> list:
    url = 'http://universities.hipolabs.com/search'

    r = requests.get(url, params={'country': country})
    r.raise_for_status()
    data = r.json()

    univerziteti = []

    for uni in data:
        univerziteti.append(uni['name'])

    return univerziteti


print(get_universities('Serbia'))



# 3. Informacije o kursu valuta

def get_exchange_rate(base: str, target: str) -> float:
    url = 'https://api.frankfurter.dev/v1/latest'

    params = {'base': base, 'symbols': target}

    r = requests.get(url, params=params)
    r.raise_for_status()
    data = r.json()

    return data['rates'][target]


print(get_exchange_rate('EUR', 'GBP'))
