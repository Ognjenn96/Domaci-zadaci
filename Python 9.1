# 1. Napisati funkciju safe_divide(a: float, b: float) -> float | None
# Ako se deli nulom, funkcija vraca None.

def safe_divide(a: float, b: float) -> float | None:
    try:
        return a / b
    except ZeroDivisionError:
        return None

print(safe_divide(10, 2))
print(safe_divide(10, 0))


# 2. Napisati funkciju safe_int(value: str) -> int | None
# Ako pretvaranje nije moguce, funkcija vraca None.

def safe_int(value: str) -> int | None:
    try:
        return int(value)
    except ValueError:
        return None

print(safe_int('25'))
print(safe_int('-10'))
print(safe_int('abc'))

# 3. Napisati funkciju get_grade(grades: dict, student: str) -> int | None
# Ako student ne postoji, funkcija vraca None.

def get_grade(grades: dict, student: str) -> int | None:
    try:
        return grades[student]
    except KeyError:
        return None

print(get_grade({'Ana': 5, 'Marko': 4, 'Jovana': 5}, 'Marko'))
print(get_grade({'Ana': 5, 'Marko': 4, 'Jovana': 5}, 'Petar'))





# 5. Napisati funkciju sum_numbers(values: list) -> float
# Sabira brojeve, a neispravne vrednosti preskace.

def sum_numbers(values: list) -> float:
    total = 0

    for value in values:
        try:
            total += float(value)
        except ValueError:
            continue

    return total

print(sum_numbers(['10', '5.5', 'abc', '3', 'hello']))


# 6. Napisati funkciju get_age(csv_line: str) -> int | None
# Ako godine ne postoje ili nisu ispravne, vraca None.

def get_age(csv_line: str) -> int | None:
    try:
        name, age = csv_line.split(',')
        return int(age)
    except ValueError:
        return None

print(get_age('Ana,22'))
print(get_age('Marko,abc'))
print(get_age('Jovana'))








