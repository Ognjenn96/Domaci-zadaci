---  Koliko redova ima spoj matches i player_match_stats za sezonu 2024/25? Objasnite.

SELECT COUNT(*) AS broj_redova FROM matches AS m
JOIN player_match_stats AS p ON m.match_id = p.match_id 
WHERE season = '2024/25';

--- Koliko puta je igrač u istoj sezoni igrao za dva različita kluba?
WITH igraci AS (
 SELECT s.player_id, m.season
FROM player_match_stats s
JOIN matches m
 ON s.match_id = m.match_id
 WHERE s.minutes_played > 0
 GROUP BY s.player_id, m.season
 HAVING COUNT(DISTINCT s.team_id) > 1)
SELECT COUNT(*) AS broj_slucajeva
FROM igraci;

--- Koliko utakmica ima više kartona od prosečne utakmice? Bezkartona računajte sa 0.

WITH kartoni AS (
SELECT  m.match_id, COUNT(e.event_id) AS broj_kartona
 FROM matches m
LEFT JOIN match_events e
 ON m.match_id = e.match_id
AND e.event_type IN ('yellow_card', 'red_card', 'second_yellow')
GROUP BY m.match_id)
SELECT COUNT(*) AS broj_utakmica
FROM kartoni
WHERE broj_kartona > (
    SELECT AVG(broj_kartona)
    FROM kartoni);

--- Koliko igrača je odigralo više od 10 utakmica u sezoni 2024/25?

WITH igraci AS (
SELECT s.player_id, COUNT(*) AS broj_utakmica
FROM player_match_stats s
JOIN matches m
ON s.match_id = m.match_id
WHERE m.season = '2024/25'
AND s.minutes_played > 0
GROUP BY s.player_id
HAVING COUNT(*) > 10)
SELECT COUNT(*) AS broj_igraca
FROM igraci;

-- Prikažite sve klubove koji su igrali u sezoni 2024/25, bilo kao domaćini ili kao gosti. Koristite UNION, a zatim izmenite upit tako da koristi UNION ALL. Objasnite razliku u broju redova koji dobijate.
--1

SELECT home_team AS klub
FROM matches_flat
WHERE season = '2024/25'

UNION

SELECT away_team AS klub
FROM matches_flat
WHERE season = '2024/25';

--2

SELECT home_team AS klub
FROM matches_flat
WHERE season = '2024/25'

UNION ALL

SELECT away_team AS klub
FROM matches_flat
WHERE season = '2024/25';

