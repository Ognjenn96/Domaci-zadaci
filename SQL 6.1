---1. Kreiranje dimenzije igrača Na osnovu tabele players napravite tabelu dim_player koja sadrži sledeće kolone: playerid, ime, prezime, poziciju i nacionalnost igrača.Koliko redova ima novokreirana tabela?

CREATE OR REPLACE TABLE dim_player AS
SELECT player_id,
first_name AS ime,
last_name AS prezime,
position AS pozicija,
nationality AS nacionalnost
FROM players;

SELECT COUNT(*) AS broj_igraca
FROM dim_player;


----2 
CREATE OR REPLACE TABLE dim_date AS
SELECT CAST(DATE_FORMAT(d, 'yyyyMMdd') AS INT) AS date_key,
d AS full_date,DATE_FORMAT(d, 'EEEE') AS weekday_name,
DAYOFWEEK(d) IN (1, 7) AS is_weekend,
CASE WHEN MONTH(d) >= 7
THEN CONCAT(YEAR(d), '/', SUBSTRING(CAST(YEAR(d) + 1 AS STRING), 3, 2))
ELSE CONCAT(YEAR(d) - 1, '/', SUBSTRING(CAST(YEAR(d) AS STRING), 3, 2))
END AS season
FROM (SELECT EXPLODE(SEQUENCE(DATE'2023-07-01', DATE'2025-06-30', INTERVAL 1 DAY)) AS d);

CREATE OR REPLACE TABLE fact_player_match AS
SELECT s.match_id,
CAST(DATE_FORMAT(m.kickoff_ts, 'yyyyMMdd') AS INT) AS date_key,
s.player_id, s.team_id, s.minutes_played, s.shots, s.passes, s.rating
FROM player_match_stats s
JOIN matches m ON s.match_id = m.match_id
WHERE m.status = 'played';

SELECT COUNT(*)
FROM fact_player_match;


----------3

SELECT p.pozicija,
ROUND(AVG(f.rating), 2) AS prosecna_ocena
FROM fact_player_match f
JOIN dim_player p ON f.player_id = p.player_id
JOIN dim_date d ON f.date_key = d.date_key
WHERE d.season = '2024/25'
AND f.rating <> 'nan'
GROUP BY p.pozicija
ORDER BY prosecna_ocena DESC;


--------- 4

ALTER TABLE fact_player_match
ADD COLUMNS (broj_golova INT);

UPDATE fact_player_match f
SET broj_golova = (SELECT COUNT(*)
FROM match_events e
WHERE e.match_id = f.match_id
AND e.player_id = f.player_id
AND e.event_type IN ('goal', 'penalty_goal'));

SELECT SUM(broj_golova) AS ukupno_golova
FROM fact_player_match;



