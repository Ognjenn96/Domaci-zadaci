def count_products(csv_lines: list) -> dict:
    result = {}

    for line in csv_lines[1:]:
        customer, product, quantity = line.split(',')

        if product in result:
            result[product] += int(quantity)
        else:
            result[product] = int(quantity)

    return result

print(count_products([
    'customer,product,quantity',
    'Alice,laptop,2',
    'Bob,mouse,3',
    'Alice,laptop,1',
    'Charlie,keyboard,2',
    'Bob,mouse,1']))
